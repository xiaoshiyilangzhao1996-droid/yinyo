[
  {
    "name": "url_verification",
    "event": {
      "type": "url_verification",
      "token": "good-token",
      "challenge": "challenge-123"
    },
    "expect": {
      "status_code": 200,
      "body": {"challenge": "challenge-123"},
      "job": false
    }
  },
  {
    "name": "text_reply",
    "event": {
      "type": "event_callback",
      "uuid": "evt_text_1",
      "token": "good-token",
      "event": {
        "sender": {"sender_id": {"open_id": "ou_user"}},
        "message": {
          "message_type": "text",
          "content": "{\"text\": \"<at user_id=\\\"ou_bot\\\">Bot</at> hello\"}",
          "chat_id": "oc_chat",
          "message_id": "om_text_1"
        }
      }
    },
    "expect": {
      "status_code": 200,
      "job": true,
      "agent_text_contains": "@open_id:ou_bot hello",
      "delivery": true
    }
  },
  {
    "name": "image_reply",
    "event": {
      "type": "event_callback",
      "uuid": "evt_image_1",
      "token": "good-token",
      "event": {
        "sender": {"sender_id": {"open_id": "ou_user"}},
        "message": {
          "message_type": "image",
          "content": "{\"image_key\": \"img_fixture\"}",
          "chat_id": "oc_chat",
          "message_id": "om_image_1"
        }
      }
    },
    "expect": {
      "status_code": 200,
      "job": true,
      "agent_text_contains": "[Image message received]",
      "delivery": true
    }
  },
  {
    "name": "duplicate_text",
    "event": {
      "type": "event_callback",
      "uuid": "evt_text_1",
      "token": "good-token",
      "event": {
        "sender": {"sender_id": {"open_id": "ou_user"}},
        "message": {
          "message_type": "text",
          "content": "{\"text\": \"duplicate\"}",
          "chat_id": "oc_chat",
          "message_id": "om_text_1"
        }
      }
    },
    "expect": {
      "status_code": 200,
      "duplicate": true,
      "job": false
    }
  }
]
